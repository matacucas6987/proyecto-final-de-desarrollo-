    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
